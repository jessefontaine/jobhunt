# jobhunt workspace config. Edit the queries to match what you are looking for; the source
# set is Netherlands-centric (see the engine README for what each source does).
# Add a source: write src/jobhunt/sources/<name>.py in the engine, register it in
# sources/__init__.py, then enable it here.

# Optional: put an email here and scrapers identify themselves with it in the User-Agent
# (polite, and lets a site contact you instead of blocking you).
# contact: you@example.org

scoring:
  model: sonnet        # passed to `claude -p --model`
  batch_size: 10       # listings per Claude call
  examples: 20         # rated listings included as few-shot examples

digest:
  limit: 60            # entries per digest, best scores first (the rest wait for the next run)

sources:
  academictransfer:
    enabled: true
    queries:
      - neuroscience
      - cognitive neuroscience
      - fMRI
      - computational neuroscience
      - machine learning brain
      - psychology

  euraxess:
    enabled: true
    # NOTE (2026-09): the site currently ignores its own keyword/country filters, so results
    # are post-filtered on the Work Locations country. Expect few hits until the site is fixed.
    country: Netherlands
    country_id: 798
    keywords: [neuroscience, cognitive]
    pages: 2           # 10 results per page, per keyword; the site rate-limits (429) quickly

  pages:
    enabled: true
    # Generic selector-driven scraper. Each entry: name, url, item (CSS, one per vacancy), and
    # optional title/link/location/deadline/summary selectors, allow_empty, or manual: true
    # (JS-only sites — just linked in the digest header for you to check by hand).
    # Universities and UMCs post on AcademicTransfer already; list places that don't.
    pages:
      - name: Netherlands Institute for Neuroscience
        url: https://nin.nl/vacancies/
        item: article.vacancies-big-card
        title: h3
        link: a.overlay-link
        allow_empty: true
      - name: TNO (neuro)
        url: https://www.tno.nl/en/careers/vacancies/?zoeken_term=neuro
        item: div.ipx-pt-vacancy
        title: h3
        link: a
        location: dd.extra-werklocatie
        allow_empty: true
      - name: TNO (cognitive)
        url: https://www.tno.nl/en/careers/vacancies/?zoeken_term=cognitive
        item: div.ipx-pt-vacancy
        title: h3
        link: a
        location: dd.extra-werklocatie
        allow_empty: true
      - name: TNO (perception)
        url: https://www.tno.nl/en/careers/vacancies/?zoeken_term=perception
        item: div.ipx-pt-vacancy
        title: h3
        link: a
        location: dd.extra-werklocatie
        allow_empty: true
      - name: TNO (human factors)
        url: https://www.tno.nl/en/careers/vacancies/?zoeken_term=human+factors
        item: div.ipx-pt-vacancy
        title: h3
        link: a
        location: dd.extra-werklocatie
        allow_empty: true
      - name: Spinoza Centre vacancies
        url: https://www.spinozacentre.nl/opportunities/vacancies/
        manual: true       # "no open positions" page with no list markup yet; check by hand
      - name: Amsterdam UMC vacancies
        url: https://werkenbij.amsterdamumc.org/vacatures?q=neuro
        manual: true       # JS-rendered; also on AcademicTransfer
      - name: Donders Institute vacancies
        url: https://www.ru.nl/en/working-at/vacancies
        manual: true       # JS-rendered; also on AcademicTransfer

  indeed:
    enabled: true      # manual only: Indeed blocks scrapers, so this just adds links to the digest
    domain: nl.indeed.com
    queries: [neuroscience, "cognitive psychology research"]
    location: Nederland

  linkedin:
    enabled: true      # best effort via the public guest search (last 30 days); manual link if blocked
    queries: [neuroscience, "cognitive neuroscience", "computational neuroscience", "research assistant psychology"]
    location: Netherlands
